 "budgets": {
  "_about": "Budget = calibration mean input code length per evaluation unit: bytes (main + later) of the image each question uses, averaged over the unit's questions, then an equal-weight mean over units (GQA unit = image; DocVQA unit = document, tasks.docvqa.unit_field = cluster_id: the per-question page-image bytes are averaged within each document, then documents are averaged with equal weight; not the sum of bytes over a document's pages). Tier types: gap (cheapest reference-family candidate whose calibration score >= Z|Z + value*(C|C - Z|Z)), cc (>= value*C|C), abs (>= value), raw_fraction (value x bytes of C|C), bytes (fixed). Each family then takes its best calibration candidate within the budget.",
  "reference_family": "S",
  "tiers": {
   "near_full": {
    "type": "gap",
    "value": 0.95
   },
   "strong": {
    "type": "gap",
    "value": 0.6
   }
  }
 },
 "targets": {
  "_about": "Common task target for bytes-to-target. Same rule types as tiers (gap, cc, abs). basis 'split': the rule is applied to each split's own C|C / Z|Z (calibration for the choice, test for 'reached'); 'calibration': one absolute number from calibration used on both splits.",
  "t95": {
   "type": "gap",
   "value": 0.95,
   "basis": "split"
  }
 },
 "bd": {
  "min_points": 3,
  "min_points_in_overlap": 2,
  "min_overlap_score": 0.02,
  "min_overlap_log10": 0.15,
  "_about": "Curves: each family's calibration-Pareto candidates evaluated on test. Not reported (with the reason) when coverage is short."
 },
 "training": {
  "_about": "Cross-evaluation of the training pilot. Arms come from run meta lora.meta[meta_fields.arm] via arm_aliases; base = lora null. Tiers: {'config': name} fixes the codestream config (same bytes for every arm), or {'bytes': B, 'candidates': [...]} lets each arm take its best calibration-split candidate within B (test envelope, labelled, when an evaluation has no calibration rows). Bytes to target: the cheapest target_candidates config reaching the reference target, chosen the same way.",
